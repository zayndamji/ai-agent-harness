# Copy to .env and fill in. Docker Compose reads .env from this folder.

# The folder on this machine that Claude works in, seen as /workspace in the container.
# Move a project into it to work on it, and back out when you're done. Claude Code's
# login and history are kept in its .claude-home. The container sees nothing else.
HARNESS_WORKSPACE=~/SandboxedWorkspace

# Password for the web UI, 8 characters or more. The web service won't start without it.
HARNESS_PASSWORD=

# The port the web UI uses on this machine. Only this computer can open it,
# unless you start it with ./start.sh --lan.
HARNESS_PORT=28471

# Extra arguments for claude in the web UI, for example: --permission-mode auto
HARNESS_CLAUDE_ARGS=

# How many sessions may run at once. Each claude takes a few hundred MB of memory.
HARNESS_MAX_SESSIONS=10
